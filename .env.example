# Copy to .env.local (git-ignored) and fill in. Shared by apps/web and apps/extension.
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration.
# These identify the project. They are not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required: Firebase AI Logic rejects requests without it).
# reCAPTCHA Enterprise score-based Web key, used by the hosted web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token, from Security > App Check > Apps > Manage debug tokens.
# Used by `npm run dev:web` (localhost) only, and never included in a production web build.
# This IS a secret: never commit it.
VITE_APPCHECK_DEBUG_TOKEN=

# App Check debug token for the Chrome extension (reCAPTCHA can't run in extensions).
# Create a separate token named "chrome-extension" so it can be revoked on its own.
# It is built into apps/extension/dist. Never commit it.
VITE_EXTENSION_APPCHECK_DEBUG_TOKEN=
