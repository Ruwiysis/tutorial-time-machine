{
  "manifest_version": 3,
  "name": "Tutorial Time-Machine",
  "version": "1.0.2",
  "description": "Warns you while you read when a coding tutorial's code is outdated, and shows the modern fix. Gemini Nano on-device + Gemini in the cloud.",
  "minimum_chrome_version": "139",
  "action": {
    "default_title": "Tutorial Time-Machine",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
